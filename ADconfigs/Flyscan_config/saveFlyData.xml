<?xml version="1.0"?>


<!--

You MUST set EPICS_CA_MAX_ARRAY_BYTES to >= 1280000 to read the maximum
number of data points the MCS can be told to acquire (usxLAX:3820:MaxChannels).

This is programmed into the Python code that reads this file.

This file will be validated (as an initial step) by the data capture (saveFlyData.py) program.
Additionally, you can check this file for validity and that all PVs exist with this command line program::

  /APSshare/anaconda/x86_64/bin/python check_saveFlyData.py

 -->


<saveFlyData version="2.0">
    <triggerPV pvname="usxLAX:USAXSfly:Start"
        start_value="1"
        start_text="Busy"
        done_value="0"
        done_text="Done" />
    <timeoutPV pvname="usxLAX:USAXS:FS_timeout" units="s" />

    <NX_structure>  <!-- http://download.nexusformat.org/doc/html/classes/base_classes/ -->
        <group name="/" class="file">
            <attribute name="instrument" value="APS USAXS at 12-ID-E" />
            <attribute name="scan_mode" value="USAXS fly scan" />
            <attribute name="canSAS_class" value="SASroot" />
            <attribute name="default" value="entry" />

            <group name="entry" class="NXentry">
                <attribute name="canSAS_class" value="SASentry" />
                <attribute name="default" value="flyScan" />

                <field name="program_name">
                    <!-- version of this configuration file -->
                    <attribute name="config_version" value="2.0" />
                    <attribute name="counting_chain" value="FX4" />
                    <text>saveFlyData.py</text>
                </field>
                <PV label="title" pvname="usxLAX:sampleTitle" string="true" />
                <PV label="experiment_identifier" pvname="usxLAX:GUPNumber" />
                <PV label="run_cycle" pvname="usxLAX:RunCycle" />

				<group name="bss" class="NXnote">
					<group name="esaf" class="NXnote">
						<PV label="id"              pvname="usxTerms:bss:esaf:id"              string="true" />
						<PV label="title"           pvname="usxTerms:bss:esaf:title"           string="true" />
						<PV label="sector"          pvname="usxTerms:bss:esaf:sector"          string="true" />
						<PV label="status"          pvname="usxTerms:bss:esaf:status"          string="true" />
						<PV label="start"           pvname="usxTerms:bss:esaf:start"           string="true" />
						<PV label="end"             pvname="usxTerms:bss:esaf:end"             string="true" />
						<PV label="pi_name"         pvname="usxTerms:bss:esaf:pi_name"         string="true" />
						<PV label="user_last_names" pvname="usxTerms:bss:esaf:user_last_names" string="true" />
						<PV label="user_count"      pvname="usxTerms:bss:esaf:user_count" />
					</group>
					<group name="proposal" class="NXnote">
						<PV label="id"              pvname="usxTerms:bss:proposal:id"              string="true" />
						<PV label="title"           pvname="usxTerms:bss:proposal:title"           string="true" />
						<PV label="start"           pvname="usxTerms:bss:proposal:start"           string="true" />
						<PV label="end"             pvname="usxTerms:bss:proposal:end"             string="true" />
						<PV label="pi_name"         pvname="usxTerms:bss:proposal:pi_name"         string="true" />
						<PV label="user_last_names" pvname="usxTerms:bss:proposal:user_last_names" string="true" />
						<PV label="mail_in"         pvname="usxTerms:bss:proposal:mail_in" />
						<PV label="proprietary"     pvname="usxTerms:bss:proposal:proprietary" />
						<PV label="user_count"      pvname="usxTerms:bss:proposal:user_count" />
					</group>
				</group>

                <group name="instrument" class="NXinstrument">
                    <attribute name="canSAS_class" value="SASinstrument" />

                    <field name="name">
                        <attribute name="short_name" value="USAXS" />
                        <text>APS USAXS at 12-ID-E</text>
                    </field>
                    <group name="source" class="NXsource">
                        <PV label="incident_wavelength" pvname="12ida2:LambdaCalc">
                            <attribute name="units" value="Angstrom" />
                        </PV>
                    </group>
                    <group name="monochromator" class="NXmonochromator">
                        <PV label="energy" pvname="12ida2:EnCalc.VAL">
                            <attribute name="units" value="keV" />
                        </PV>
                        <link name="wavelength" source="/entry/instrument/source/incident_wavelength" />
                    </group>
                </group>
                <group name="sample" class="NXsample">
                    <attribute name="canSAS_class" value="SASsample" />
                    <PV label="name" pvname="usxLAX:sampleTitle" string="true" />
                    <PV label="thickness" pvname="usxLAX:sampleThickness" />
                    <PV label="description" pvname="usxSample:Description" />
                    <PV label="chemical_formula" pvname="usxSample:ChemicalFormula" />

                    <PV label="temperature" pvname="usxSample:Temperature">
                        <attribute name="units" value="C" />
                    </PV>
                    <PV label="concentration" pvname="usxSample:Concentration">
                        <attribute name="units" value="g/cm3" />
                    </PV>
                    <PV label="volume_fraction" pvname="usxSample:VolumeFraction" />
                    <PV label="scattering_length_density" pvname="usxSample:ScatteringLengthDensity">
                        <attribute name="units" value="cm/cm3" />
                    </PV>
                    <PV label="magnetic_field" pvname="usxSample:MagneticField" />
                    <PV label="stress_field" pvname="usxSample:StressField" />
                    <PV label="electric_field" pvname="usxSample:ElectricField">
                        <attribute name="units" value="V" />
                    </PV>
                    <PV label="x_translation" pvname="usxSample:XTranslation">
                        <attribute name="units" value="mm" />
                    </PV>
                    <PV label="rotation_angle" pvname="usxSample:RotationAngle">
                        <attribute name="units" value="degrees" />
                    </PV>

                    <PV label="magnetic_field_direction" pvname="usxSample:MagneticFieldDir" />
                    <PV label="stress_field_direction" pvname="usxSample:StressFieldDir" />
                    <PV label="electric_field_direction" pvname="usxSample:ElectricFieldDir" />
                </group>

                <group name="flyScan" class="NXdata">
                    <!-- this raw data group is not SASdata, that comes from data reduction -->
                    <attribute name="signal"     value="upd_current" />

                    <!-- positioners -->
                    <PV label="AR_PulsePositions" pvname="usxAERO:pm1:PulsePositions">
                        <attribute name="units" value="degrees" />
                    </PV>
                    <PV label="AR_pulses" pvname="usxAERO:pm1:NumPulses" />
                    <PV label="AR_PulseMode" pvname="usxAERO:pm1:PulseMode" />
                    <PV label="AR_count" pvname="usxAERO:pm1:NumPulses" />
                    <!--
                       PulseMode is a string describing the type of scan:

                       1. Fixed: fixed pulses as before (we should have that nailed down by now already)
                       2. Array: use PulsePositions 									<<<this is what it shoudl ALWAYS be. 
                       3. TrajPts: use trajectory points (the 200 points in current trajectory)
                    -->
                    <PV label="AR_waytpointsNum" pvname="usxAERO:pm1:NumPoints">
                        <attribute name="units" value="pulses" />
                    </PV>
                    <PV label="AR_waypoints" pvname="usxAERO:pm1:M6Positions" length_limit="AR_count">
                        <attribute name="units" value="degrees" />
                    </PV>
                    <!-- These do not have equivalent for pm1
                    <PV label="time_elapsed" pvname="usxAERO:pm1:NumPoints" acquire_after_scan="true">
                        <attribute name="units" value="s" />
                    </PV>
                   -->
                    <PV label="AR_start" pvname="usxLAX:USAXS:ARstart">
                        <!-- pushed here by SPEC usaxs_flyscan.txt macro -->
                        <attribute name="units" value="degrees" />
                    </PV>
                    <PV label="AR_increment" pvname="usxLAX:USAXS:MinStep">
                        <attribute name="units" value="degrees" />
                    </PV>
                    <PV label="AR_MinStepTraj" pvname="usxLAX:USAXS:MinStepTraj">
                        <!-- minimum step of trajectory waypoints -->
                        <attribute name="units" value="degrees" />
                    </PV>
                    <PV label="AR_Finish" pvname="usxLAX:USAXS:Finish">
                        <attribute name="units" value="degrees" />
                    </PV>
                    <PV label="StartOffset" pvname="usxLAX:USAXS:StartOffset">
                        <attribute name="units" value="degrees" />
                    </PV>

                     <PV label="time_per_waypoint" pvname="usxAERO:pm1:FixedTime">
                        <attribute name="units" value="s" />
                    </PV>


                    <!-- ==========================================================
                         DETECTORS: FX4 electrometers      counting_chain = "FX4"
                         ==========================================================
                         PSO-gated ("Ext. bulb") mode: each strobe closes one
                         exposure and the driver appends that interval's average
                         current to a per-channel time series.

                         Units are pA and the reading is GAIN-INDEPENDENT.  There
                         is no amplifier gain to divide by and no per-range gain
                         table: I(q) comes from upd_current / I0_current directly.

                         Nor is there a dwell-time term.  The Struck recorded
                         accumulated counts, so mca2/mca3 had to be divided by
                         mca1 (the 50 MHz clock) to get a rate.  TSMeanValue is
                         already an average over the interval, and both
                         electrometers take the same PSO gate, so the ratio is
                         valid point by point with no timing correction.

                         channel_time is therefore a DIAGNOSTIC, not part of
                         normalisation.  It is derived by saveFlyData.py as
                             N[i]  = I0_total[i] / I0_current[i]
                             dt[i] = N[i] * sample_time
                         and is useful for stage-tuning jitter and for the
                         uncertainty of each point (sigma_mean = sigma / sqrt(N)).

                         Check ring_overflows: non-zero means the driver's ring
                         buffer filled, the oldest samples were dropped, and the
                         means are biased toward the end of each interval.
                         ========================================================== -->

                    <PV label="n_points" pvname="usxFX4:FX4:Current1:TSCurrentPoint" acquire_after_scan="true">
                        <attribute name="meaning" value="PSO pulses actually captured; array length limit" />
                    </PV>
                    <PV label="sample_time" pvname="usxFX4:FX4:SampleTime_RBV">
                        <attribute name="units" value="s" />
                        <attribute name="meaning" value="ValuesPerRead x 10 us" />
                    </PV>
                    <PV label="values_per_read" pvname="usxFX4:FX4:ValuesPerRead" />
                    <PV label="ring_overflows" pvname="usxFX4:FX4:RingOverflows" acquire_after_scan="true">
                        <attribute name="meaning" value="non-zero: samples dropped, means biased" />
                    </PV>
                    <PV label="ring_overflows_I0" pvname="usxFX42:FX4:RingOverflows" acquire_after_scan="true" />

                    <!-- UPD: usxFX4 Current1 -->
                    <PV label="upd_current" pvname="usxFX4:FX4:Current1:TSMeanValue" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="signal" value="1" />
                        <attribute name="units" value="pA" />
                        <attribute name="USAXS_name" value="upd" />
                        <attribute name="meaning" value="mean photocurrent over each PSO interval" />
                    </PV>
                    <PV label="upd_sigma" pvname="usxFX4:FX4:Current1:TSSigma" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="units" value="pA" />
                        <attribute name="meaning" value="std of samples WITHIN each interval, not the error of the mean; divide by sqrt(N) for that" />
                    </PV>
                    <PV label="upd_total" pvname="usxFX4:FX4:Current1:TSTotal" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="meaning" value="sum of samples in each interval; / mean = sample count N" />
                    </PV>

                    <!-- I0: usxFX42 Current1 -->
                    <PV label="I0_current" pvname="usxFX42:FX4:Current1:TSMeanValue" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="units" value="pA" />
                        <attribute name="USAXS_name" value="I0" />
                    </PV>
                    <PV label="I0_sigma" pvname="usxFX42:FX4:Current1:TSSigma" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="units" value="pA" />
                    </PV>
                    <PV label="I0_total" pvname="usxFX42:FX4:Current1:TSTotal" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="meaning" value="used with I0_current to derive channel_time" />
                    </PV>

                    <!-- I00: usxFX42 Current2.  Nothing connected yet. -->
                    <PV label="I00_current" pvname="usxFX42:FX4:Current2:TSMeanValue" length_limit="n_points" acquire_after_scan="true">
                        <attribute name="units" value="pA" />
                        <attribute name="USAXS_name" value="I00" />
                    </PV>

                    <!-- Ranges. DIAGNOSTIC ONLY: the reading is gain-independent,
                         so nothing downstream divides by these. They are here so a
                         railed range is visible after the fact. -->
                    <PV label="fx4_range" pvname="usxFX4:FX4:Range" acquire_after_scan="true" />
                    <PV label="fx42_range" pvname="usxFX42:FX4:Range" acquire_after_scan="true" />
                    <PV label="upd_lurange" pvname="usxFX4:FX4:seq01:lurange" acquire_after_scan="true" />
                    <PV label="upd_autorange_channel" pvname="usxFX4:FX4:seq01:channel" />

                    <!-- UPD dark current per range, from the FX4 sequence program.
                         One table per program, and on usxFX4 that program serves
                         both UPD and TRD, so only UPD's dark is recorded here. -->
                    <PV label="upd_bkg0" pvname="usxFX4:FX4:seq01:bkg0" />
                    <PV label="upd_bkgErr0" pvname="usxFX4:FX4:seq01:bkgErr0" />
                    <PV label="upd_bkg1" pvname="usxFX4:FX4:seq01:bkg1" />
                    <PV label="upd_bkgErr1" pvname="usxFX4:FX4:seq01:bkgErr1" />
                    <PV label="upd_bkg2" pvname="usxFX4:FX4:seq01:bkg2" />
                    <PV label="upd_bkgErr2" pvname="usxFX4:FX4:seq01:bkgErr2" />
                    <PV label="upd_bkg3" pvname="usxFX4:FX4:seq01:bkg3" />
                    <PV label="upd_bkgErr3" pvname="usxFX4:FX4:seq01:bkgErr3" />
                    <PV label="upd_bkg4" pvname="usxFX4:FX4:seq01:bkg4" />
                    <PV label="upd_bkgErr4" pvname="usxFX4:FX4:seq01:bkgErr4" />

                    <!-- Superseded: Struck 3820 MCS and the Femto amplifiers.
                         Nothing feeds these once the diodes are wired to the FX4.
                         Kept commented so a rollback is an uncomment.
                    [  detectors  ]
                    <PV label="mca_clock_frequency" pvname="usxLAX:3820:clock_frequency">
                        <attribute name="units" value="1/s" />
                    </PV>
                    <PV label="mca_channels" pvname="usxLAX:3820:CurrentChannel" acquire_after_scan="true" />
                    <PV label="mca_channel_max" pvname="usxLAX:3820:MaxChannels" />
                    <PV label="mca_channels_used" pvname="usxLAX:3820:NuseAll" acquire_after_scan="true">
                        <attribute name="meaning" value="number of Struck channels to use" />
                    </PV>

                    <PV label="mca1_name" pvname="usxLAX:3820:scaler1.NM1" />
                    <PV label="mca1" pvname="usxLAX:3820:mca1" length_limit="mca_channels"  acquire_after_scan="true">     [  counts of 50 MHz clock  ]
                        <attribute name="units" value="pulses" />
                        <attribute name="USAXS_name" value="clock_pulses" />
                    </PV>

                    <PV label="mca2_name" pvname="usxLAX:3820:scaler1.NM2" />
                    <PV label="mca2" pvname="usxLAX:3820:mca2" length_limit="mca_channels" acquire_after_scan="true">
                        <attribute name="units" value="counts" />
                        <attribute name="USAXS_name" value="I0" />
                    </PV>

                    <PV label="mca3_name" pvname="usxLAX:3820:scaler1.NM3" />
                    <PV label="mca3" pvname="usxLAX:3820:mca3" length_limit="mca_channels" acquire_after_scan="true">
                        <attribute name="signal" value="1" />
                        <attribute name="units" value="pulses" />
                        [  <attribute name="axes" value="AR" />  ]
                        [  The proper ordinate is obtained via the MAC channel index:
                            AR[i] = AR_start + AR_increment * i

                            Can the AR array be made available in EPICS?
                         ]
                        <attribute name="USAXS_name" value="upd" />
                    </PV>

                    [  2014-02-28, PRJ
                        The following PVs record amplifier gain changes
                        and the corresponding MCS channel number at which the change occurred
                        for each of four detector amplifiers.  (Two monitors and two UPD amplifiers)
                        Choice of the UPD amplifier in use is found in: usxUSX:femto:model
                        which takes either of these two values:
                        * 0: "DLPCA200"
                        * 1: "DDPCA300"
                         ]

                    <PV label="upd_flyScan_amplifier"         pvname="usxRIO:femto:model" />   
			[ saves as number, not string
                 	   <PV label="upd_flyScan_amplifier_ZNAM"    pvname="usxRIO:femto:model.ZNAM" />
                  	   <PV label="upd_flyScan_amplifier_ONAM"    pvname="usxRIO:femto:model.ONAM" />
			 ]

                    [  these record when the amplifiers have changed gain during the fly scan  ]
                    <PV label="changes_I0_mcsChan"       pvname="usxLAX:USAXSfly:I0:mcsChan" acquire_after_scan="true" />
                    <PV label="changes_I0_ampGain"       pvname="usxLAX:USAXSfly:I0:ampGain" acquire_after_scan="true" />
                    <PV label="changes_I0_ampReqGain"    pvname="usxLAX:USAXSfly:I0:ampReqGain" acquire_after_scan="true" />

                    <PV label="changes_I00_mcsChan"      pvname="usxLAX:USAXSfly:I00:mcsChan" acquire_after_scan="true" />
                    <PV label="changes_I00_ampGain"      pvname="usxLAX:USAXSfly:I00:ampGain" acquire_after_scan="true" />
                    <PV label="changes_I00_ampReqGain"   pvname="usxLAX:USAXSfly:I00:ampReqGain" acquire_after_scan="true" />

                    <PV label="changes_DLPCA200_mcsChan"    pvname="usxLAX:USAXSfly:DLPCA200:mcsChan" acquire_after_scan="true" />
                    <PV label="changes_DLPCA200_ampGain"    pvname="usxLAX:USAXSfly:DLPCA200:ampGain" acquire_after_scan="true" />
                    <PV label="changes_DLPCA200_ampReqGain" pvname="usxLAX:USAXSfly:DLPCA200:ampReqGain" acquire_after_scan="true" />

                    <PV label="changes_DDPCA300_mcsChan"    pvname="usxLAX:USAXSfly:DDPCA300:mcsChan" acquire_after_scan="true" />
                    <PV label="changes_DDPCA300_ampGain"    pvname="usxLAX:USAXSfly:DDPCA300:ampGain" acquire_after_scan="true" />
                    <PV label="changes_DDPCA300_ampReqGain" pvname="usxLAX:USAXSfly:DDPCA300:ampReqGain" acquire_after_scan="true" />
		    
                    [  These do nto sseem to exist, not needed? 
						<PV label="dyMaxSpeed" pvname="usxLAX:USAXSfly:dyMaxSpeed" />
						<PV label="ayMaxSpeed" pvname="usxLAX:USAXSfly:ayMaxSpeed" />
						<PV label="arMaxSpeed" pvname="usxLAX:USAXSfly:arMaxSpeed" />
                        <PV label="FS_AyMaxSpeed" pvname="usxLAX:USAXS:FS_AyMaxSpeed" />
                        <PV label="FS_DyMaxSpeed" pvname="usxLAX:USAXS:FS_DyMaxSpeed" />
                        <PV label="FS_ArMaxSpeed" pvname="usxLAX:USAXS:FS_ArMaxSpeed" />
                     ]
                    <PV label="FS_ElapsedTime" pvname="usxLAX:3820:ElapsedReal" acquire_after_scan="true" />

                    <PV label="FS_NumberOfPoints" pvname="usxLAX:USAXS:FS_NumberOfPoints">
                        <attribute name="meaning" value="number of waypoints in trajectory scan" />
                    </PV>
                    <PV label="FS_ScanTime" pvname="usxLAX:USAXS:FS_ScanTime" />

                    <PV label="changes_AR_PSOpulse"    pvname="usxLAX:USAXSfly:AR:mcsChan" acquire_after_scan="true" />
                    <PV label="changes_AR_angle"      pvname="usxLAX:USAXSfly:AR:pos" acquire_after_scan="true" >
                        <attribute name="meaning"      value="AR readback when PSO pulse fired with 10Hz jitter" />
                    </PV>

                    <PV label="is_2D_USAXS_scan"    pvname="usxLAX:USAXS:is2DUSAXSscan" >
                        <attribute name="meaning"     value="does this scan use 2D collimated geometry" />
                    </PV>

                </group>    [  entry:NXentry/flyScan:NXdata  ]


                [  metadata  ]
                <group name="metadata" class="NXcollection">    [  metadata:NXcollection  ]

                    [  beam line conditions  ]
                    <PV label="SR_current" pvname="S:SRcurrentAI">
                        <attribute name="units" value="A" />
                    </PV>
                    <PV label="ID_E" pvname="S12ID:USID:EnergyM.VAL">
                        <attribute name="units" value="keV" />
                    </PV>
                    <PV label="DCM_energy" pvname="12ida2:EnCalc">
                        <attribute name="units" value="keV" />
                    </PV>
                    <PV label="DCM_wavelength" pvname="12ida2:LambdaCalc">
                        <attribute name="units" value="Angstrom" />
                    </PV>
                    <PV label="DCM_theta" pvname="12ida2:m19.RBV">
                        <attribute name="units" value="degrees" />
                    </PV>

                    [  SPEC  ]
                    <PV label="SPEC_macro_file_string19" pvname="usxLAX:string19" string="true" />
                    <PV label="SPEC_macro_file" pvname="usxLAX:macroFile" string="true" />
                    <PV label="SPEC_data_file" pvname="usxLAX:specFile" string="true" />
                    <PV label="SPEC_data_dir" pvname="usxLAX:userDir" string="true" />
                    <PV label="spec_scan" pvname="usxLAX:specScan" />
                    <PV label="state" pvname="usxLAX:state" string="true" />
                    <PV label="timeStamp" pvname="usxLAX:timeStamp" string="true" />

                    [  USAXS terms  ]
                    <PV label="analyzer_distance" pvname="usxLAX:USAXS:SAD" />
                    <PV label="detector_distance" pvname="usxLAX:USAXS:SDD" />
                    <PV label="UATerm" pvname="usxLAX:USAXS:UATerm" />
                    <PV label="MR_center" pvname="usxLAX:USAXS:MRcenter" />
                    <PV label="MSR_center" pvname="usxLAX:USAXS:MSRcenter" />
                    <PV label="AR_center" pvname="usxLAX:USAXS:ARcenter" />
                    <PV label="ASR_center" pvname="usxLAX:USAXS:ASRcenter" />
                    <PV label="ARenc_0" pvname="usxLAX:USAXS:Q.B" />
                    <PV label="feedback_ON" pvname="usxLAX:fbe:omega:on" />
                    <PV label="UPDsize" pvname="usxLAX:USAXS:UPDsize" />

                    [  USAXS sample slit positions  ]
                    <PV label="uslit_v_center" pvname="usxLAX:m58:c1:m6" />
                    <PV label="uslit_h_center" pvname="usxLAX:m58:c1:m5" />
                    <PV label="uslit_v_gap" pvname="usxLAX:m58:c1:m7" />
                    <PV label="uslit_h_gap" pvname="usxLAX:m58:c1:m8" />


                    [  USAXS sample pin transmission  ]
                    <PV label="measure_trans_pin" pvname="usxLAX:USAXS:TR_MeasurePinTrans" />
                    <PV label="trans_pin_aypos" pvname="usxLAX:ay_in" />
                    <PV label="trans_pin_time" pvname="usxLAX:USAXS:TR_MeasurementTime" />
                    <PV label="trans_pin_counts" pvname="usxLAX:USAXS:TR_pinCounts" />
                    <PV label="trans_pin_gain" pvname="usxLAX:USAXS:TR_pinGain" />
                    <PV label="trans_I0_counts" pvname="usxLAX:USAXS:TR_I0Counts" />
                    <PV label="trans_I0_gain" pvname="usxLAX:USAXS:TR_I0Gain" />

                    [  I0 amplifier gains at start of scan and gains and measured backgrounds  ]
                    <PV label="I0AmpGain"    pvname="usxRIO:fem02:seq01:gain" />
		

